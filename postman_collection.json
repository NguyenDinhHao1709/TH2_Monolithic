    {
      "name": "3. Products Management (5 Test Cases)",
      "item": [
        {
          "name": "TC-P2-PROD-01: Lấy danh sách sản phẩm - Public (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "response": []
        },
        {
          "name": "TC-P2-PROD-02: Thêm mới sản phẩm có JWT Token (201)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                "var json = pm.response.json();",
                "pm.test('Product has pid', function () { pm.expect(json.pid).to.not.be.undefined; });",
                "if (json.pid) { pm.collectionVariables.set('created_pid', String(json.pid)); }"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pname\": \"Mechanical Keyboard RGB Custom\",\n  \"price\": 120.00,\n  \"quantity\": 50\n}" },
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "response": []
        },
        {
          "name": "TC-P2-PROD-03: Thêm sản phẩm KHÔNG gửi token (401)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pname\": \"Unauthorized Product\",\n  \"price\": 50,\n  \"quantity\": 10\n}" },
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "response": []
        },
        {
          "name": "TC-P2-PROD-04: Lấy chi tiết sản phẩm hợp lệ (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                "var json = pm.response.json();",
                "pm.test('Matching product pid', function () { pm.expect(String(json.pid)).to.eql(pm.collectionVariables.get('created_pid')); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/{{created_pid}}", "host": ["{{base_url}}"], "path": ["api", "products", "{{created_pid}}"] }
          },
          "response": []
        },
        {
          "name": "TC-P2-PROD-05: Cập nhật giá & tồn kho sản phẩm (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                "var json = pm.response.json();",
                "pm.test('Quantity updated to 45', function () { pm.expect(json.quantity).to.eql(45); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 110.00,\n  \"quantity\": 45\n}" },
            "url": { "raw": "{{base_url}}/api/products/{{created_pid}}", "host": ["{{base_url}}"], "path": ["api", "products", "{{created_pid}}"] }
          },
          "response": []
        }
