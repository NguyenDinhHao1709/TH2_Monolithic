    {
      "name": "4. Orders & Shipments (5 Test Cases)",
      "item": [
        {
          "name": "TC-P2-ORD-01: Đặt hàng hợp lệ - Transaction nguyên tử (201)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                "var json = pm.response.json();",
                "pm.test('Order details created', function () { pm.expect(json.order.orderDetails.length).to.be.above(0); });",
                "pm.test('Shipment created with Pending', function () { pm.expect(json.order.shipments[0].status).to.eql('Pending'); });",
                "if (json.order && json.order.oid) { pm.collectionVariables.set('created_oid', String(json.order.oid)); }"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    {\n      \"pid\": {{created_pid}},\n      \"qty\": 2\n    }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "response": []
        },
        {
          "name": "TC-P2-ORD-02: Đặt hàng KHÔNG có JWT token (401)",
