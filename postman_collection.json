  "item": [
    {
      "name": "1. System & Health (1 Test Case)",
      "item": [
        {
          "name": "TC-P2-SYS-01: Health Check (API & PostgreSQL)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                "var json = pm.response.json();",
                "pm.test('API is healthy and DB is connected', function () { pm.expect(json.status).to.eql('OK'); pm.expect(json.database).to.eql('connected'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication & Authorization (6 Test Cases)",
      "item": [
        {
          "name": "TC-P2-AUTH-01: Đăng ký Customer mới hợp lệ (201)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
