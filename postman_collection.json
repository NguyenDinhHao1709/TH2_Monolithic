            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "response": []
        },
        {
          "name": "TC-P2-ORD-03: Đặt số lượng vượt quá tồn kho (400)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
